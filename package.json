{
  "name": "aboutme-portfolio",
  "version": "1.0.0",
  "description": "Filip Szwerluga's Portfolio Website",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "deploy": "npm run build && echo '✅ Build complete! Push to GitHub to deploy via GitHub Actions.'"
  },
  "keywords": [
    "portfolio",
    "gsap",
    "tailwind",
    "typescript"
  ],
  "author": "Filip Szwerluga",
  "license": "MIT",
  "dependencies": {
    "gsap": "^3.12.5",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-nunjucks": "^0.2.0"
  }
}
